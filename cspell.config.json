{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["lorem-ipsum"],
  "ignorePaths": [
    "package.json",
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "**/*.json",
    "**/*.csv",
    "**/*.md",
    "l10n/*.d.json.ts"
  ],
  "ignoreRegExpList": ["/[\\u0980-\\u09FF]+/g", "/%[0-9A-Fa-f]{2}/g"],
  "words": [
    "Aloo",
    "Anek",
    "Bangla",
    "Bengali",
    "Dhaka",
    "MERN",
    "Menlo",
    "Noto",
    "Poppins",
    "STARTTLS",
    "Segoe",
    "aloowing",
    "autorestart",
    "backdrop",
    "commitlint",
    "cooldown",
    "inlines",
    "katastarx",
    "latn",
    "lede",
    "linecap",
    "llms",
    "llmstxt",
    "maxlength",
    "metacharacter",
    "metacharacters",
    "mongodb",
    "mongoose",
    "msword",
    "nextjs",
    "nodemailer",
    "nosniff",
    "nuqs",
    "officedocument",
    "oklch",
    "opengraph",
    "openxmlformats",
    "pino",
    "prerenders",
    "presentationml",
    "ratelimits",
    "resends",
    "rulebook",
    "shadcn",
    "spreadsheetml",
    "syncable",
    "topbar",
    "uncoded",
    "uppercased",
    "vercel",
    "wordprocessingml"
  ]
}
