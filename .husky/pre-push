# --------------------------
# UNIT TESTS + TYPE CHECK + BUILD
# --------------------------
#
# `lint` and `format` already ran on every commit. The unit tests are fast and catch a
# behavioural regression the type checker cannot see; the build is what catches type
# errors, a broken metadata route or a bad env schema — both cheap here, expensive after
# they reach CI or a branch someone else pulls.

echo "Running unit tests before push..."
npm run test

echo "Running production build before push..."
npm run build
