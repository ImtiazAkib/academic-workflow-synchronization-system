# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Absolute origin the app is served from. Used for absolute links and metadata.
APP_BASE_URL=http://localhost:3000

# Allow search engines to index the site. Off by default so staging stays out of
# the index — set to true only on production.
ROBOTS_ENABLED=false

# MongoDB connection string. Required.
# The database name is NOT taken from this string — the app passes it explicitly, so
# an Atlas URI pasted without its path segment still writes to the right database.
# Local:   mongodb://127.0.0.1:27017/academic-workflow
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/academic-workflow?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session tokens, at least 32 characters.
# Generate one with: openssl rand -base64 32
# Optional until authentication lands (step 5).
AUTH_SECRET=

# --- Mail (step 12) ---------------------------------------------------------
# Optional, and deliberately so. With SMTP_HOST unset every message — the
# verification link and the login ID — is written to the log instead of sent, so
# the whole registration flow works on a laptop with no mail account at all.
#
# Set them for a real deploy. Any SMTP server works; an app password from a
# normal mail account is enough, with no sending domain to verify.
SMTP_HOST=
# 587 for STARTTLS (the default), 465 for implicit TLS.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Many relays reject a message whose sender address they do not own.
SMTP_FROM=

# --- Seeding only -----------------------------------------------------------
# Read by `npm run seed:super-admin`, never by the app. Set them for that one command
# rather than committing them here, so the password stays out of the repo:
#
#   SEED_SUPER_ADMIN_NAME="Department Head" SEED_SUPER_ADMIN_EMAIL="head@dept.edu" \
#   SEED_SUPER_ADMIN_PASSWORD="..." npm run seed:super-admin
