# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/academic-workflow
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/academic-workflow?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
# Not read by any code yet — the authentication sprint wires it up.
AUTH_SECRET=
